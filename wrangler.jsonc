{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "konj-101",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-db",
      "database_id": "52abdedd-8ca8-4169-8b79-ca9262567d77"
    }
  ]
}
