{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "after-the-last-page",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog-db",
      "database_id": "291dc2da-6dbf-4a94-882e-7c0c3feed01b"
    }
  ]
}
